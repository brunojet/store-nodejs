{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Nx Backoffice",
      "program": "${workspaceFolder}/dist/src/apps/backoffice/main.js",
      "preLaunchTask": "nx:build:backoffice",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMapPathOverrides": {
        "webpack:///./src/libs/*": "${workspaceFolder}/src/libs/*",
        "webpack:///./src/apps/backoffice/src/*": "${workspaceFolder}/src/apps/backoffice/src/*",
        "webpack:///./src/*": "${workspaceFolder}/src/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///src/*": "${workspaceFolder}/src/*",
        "webpack:///*": "*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
